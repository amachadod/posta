# Copy this file to .env for local runs. Never commit .env.
# On GitHub, add these as Actions secrets and variables instead (see the README).

# --- Gmail (one-time setup, see "Connect Gmail" in the README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Created by: npm run authorize
GOOGLE_REFRESH_TOKEN=

# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Linear (Settings -> Security & access -> Personal API keys) ---
LINEAR_API_KEY=
# Optional: override the Linear team key set in your playbook (e.g. AM)
LINEAR_TEAM=

# --- What Posta reads ---
# Which playbook describes your job (file name in /playbooks without .md)
POSTA_PLAYBOOK=account-management
# Gmail search for emails to read. Emails Posta already handled get the "Posta" label and are skipped.
POSTA_QUERY=in:inbox newer_than:2d
POSTA_MAX_EMAILS=50
# A sent email with no reply after this many days shows up under "Waiting on others"
WAIT_DAYS=3
# Your time zone, for dates in the briefing
POSTA_TIMEZONE=Europe/Lisbon

# --- What Posta does ---
CREATE_TASKS=true
CREATE_DRAFTS=true
SEND_BRIEFING=true
# Every task gets a "Needs review" label and no assignee
REVIEW_MODE=false
# Tasks Claude is less sure about than this (0 to 1) are flagged for review
MIN_CONFIDENCE=0.6
# Do everything except create tasks, drafts or the briefing. Writes briefing-preview.html locally instead.
DRY_RUN=false

# --- Zapier mode only ---
POSTA_WEBHOOK_SECRET=change-me
PORT=8788
